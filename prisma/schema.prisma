generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

model Business { id String @id @default(cuid()) name String slug String @unique gstin String? createdAt DateTime @default(now()) branches Branch[] users Staff[] }
model Branch { id String @id @default(cuid()) name String address String? businessId String business Business @relation(fields:[businessId],references:[id]) stocks Stock[] }
model Staff { id String @id @default(cuid()) name String email String @unique role String @default("SALES") active Boolean @default(true) businessId String business Business @relation(fields:[businessId],references:[id]) assignments JobCard[] }
model Customer { id String @id @default(cuid()) name String phone String email String? address String? source String @default("WALK_IN") createdAt DateTime @default(now()) leads Lead[] assets Asset[] cases ServiceCase[] orders SalesOrder[] invoices Invoice[] }
model Lead { id String @id @default(cuid()) name String phone String? source String @default("WALK_IN") interest String? stage String @default("NEW") customerId String? customer Customer? @relation(fields:[customerId],references:[id]) createdAt DateTime @default(now()) quotes Quote[] }
model Supplier { id String @id @default(cuid()) name String phone String? email String? gstin String? purchases PurchaseOrder[] }
model Product { id String @id @default(cuid()) name String sku String @unique category String brand String? price Decimal @db.Decimal(12,2) cost Decimal @default(0) @db.Decimal(12,2) specifications Json? active Boolean @default(true) createdAt DateTime @default(now()) stocks Stock[] purchaseItems PurchaseItem[] orderItems OrderItem[] quoteItems QuoteItem[] parts PartUsage[] assets Asset[] }
model Stock { id String @id @default(cuid()) productId String branchId String qty Int @default(0) reserved Int @default(0) reorderPoint Int @default(5) product Product @relation(fields:[productId],references:[id]) branch Branch @relation(fields:[branchId],references:[id]) @@unique([productId,branchId]) }
model PurchaseOrder { id String @id @default(cuid()) number String @unique supplierId String status String @default("DRAFT") total Decimal @default(0) @db.Decimal(12,2) createdAt DateTime @default(now()) supplier Supplier @relation(fields:[supplierId],references:[id]) items PurchaseItem[] }
model PurchaseItem { id String @id @default(cuid()) purchaseId String productId String qty Int cost Decimal @db.Decimal(12,2) purchase PurchaseOrder @relation(fields:[purchaseId],references:[id]) product Product @relation(fields:[productId],references:[id]) }
model Quote { id String @id @default(cuid()) number String @unique leadId String? status String @default("DRAFT") total Decimal @default(0) @db.Decimal(12,2) expiresAt DateTime? lead Lead? @relation(fields:[leadId],references:[id]) items QuoteItem[] }
model QuoteItem { id String @id @default(cuid()) quoteId String productId String qty Int unitPrice Decimal @db.Decimal(12,2) quote Quote @relation(fields:[quoteId],references:[id]) product Product @relation(fields:[productId],references:[id]) }
model SalesOrder { id String @id @default(cuid()) number String @unique customerId String status String @default("DRAFT") total Decimal @default(0) @db.Decimal(12,2) createdAt DateTime @default(now()) customer Customer @relation(fields:[customerId],references:[id]) items OrderItem[] invoices Invoice[] }
model OrderItem { id String @id @default(cuid()) orderId String productId String qty Int unitPrice Decimal @db.Decimal(12,2) serialNumber String? order SalesOrder @relation(fields:[orderId],references:[id]) product Product @relation(fields:[productId],references:[id]) }
model Asset { id String @id @default(cuid()) customerId String productId String? brand String model String? serialNumber String? condition String? receivedAccessories String? customer Customer @relation(fields:[customerId],references:[id]) product Product? @relation(fields:[productId],references:[id]) cases ServiceCase[] warranties Warranty[] }
model ServiceCase { id String @id @default(cuid()) customerId String assetId String? issue String status String @default("RECEIVED") priority String @default("NORMAL") estimate Decimal? @db.Decimal(12,2) approvedAt DateTime? createdAt DateTime @default(now()) customer Customer @relation(fields:[customerId],references:[id]) asset Asset? @relation(fields:[assetId],references:[id]) jobs JobCard[] invoices Invoice[] }
model JobCard { id String @id @default(cuid()) caseId String technicianId String? diagnosis String? status String @default("RECEIVED") laborCost Decimal @default(0) @db.Decimal(12,2) notes String? deliveredAt DateTime? case ServiceCase @relation(fields:[caseId],references:[id]) technician Staff? @relation(fields:[technicianId],references:[id]) parts PartUsage[] }
model PartUsage { id String @id @default(cuid()) jobId String productId String qty Int cost Decimal @db.Decimal(12,2) job JobCard @relation(fields:[jobId],references:[id]) product Product @relation(fields:[productId],references:[id]) }
model Warranty { id String @id @default(cuid()) assetId String startDate DateTime endDate DateTime type String @default("PRODUCT") terms String? asset Asset @relation(fields:[assetId],references:[id]) }
model Invoice { id String @id @default(cuid()) number String @unique customerId String orderId String? caseId String? subtotal Decimal @db.Decimal(12,2) tax Decimal @default(0) @db.Decimal(12,2) discount Decimal @default(0) @db.Decimal(12,2) total Decimal @db.Decimal(12,2) status String @default("UNPAID") createdAt DateTime @default(now()) customer Customer @relation(fields:[customerId],references:[id]) order SalesOrder? @relation(fields:[orderId],references:[id]) case ServiceCase? @relation(fields:[caseId],references:[id]) payments Payment[] }
model Payment { id String @id @default(cuid()) invoiceId String amount Decimal @db.Decimal(12,2) method String reference String? paidAt DateTime @default(now()) invoice Invoice @relation(fields:[invoiceId],references:[id]) }
model Communication { id String @id @default(cuid()) channel String recipient String template String? status String @default("QUEUED") externalId String? createdAt DateTime @default(now()) }
model AuditLog { id String @id @default(cuid()) actorId String? action String entity String entityId String before Json? after Json? at DateTime @default(now()) }
model CustomField { id String @id @default(cuid()) entity String key String label String type String required Boolean @default(false) options Json? @@unique([entity,key]) }
model BusinessSetting { id String @id @default(cuid()) key String @unique value Json }
