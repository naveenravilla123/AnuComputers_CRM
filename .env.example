# Copy this file to .env for local development and replace the placeholders.
# Use a separate database for this CRM. URL-encode special characters in credentials.
DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/anu_computers_crm?schema=public"

# Generate a long random secret. Keep it private and out of browser code.
CRM_API_KEY="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# On Vercel, set DATABASE_URL and CRM_API_KEY in the project environment
# variables for each deployment environment. Use a hosted PostgreSQL URL;
# localhost in Vercel refers to the deployment, not your computer.

CRM_ADMIN_EMAIL="YOUR_ADMIN_EMAIL"
CRM_ADMIN_PASSWORD="REPLACE_WITH_A_STRONG_PASSWORD"
CRM_SESSION_SECRET="REPLACE_WITH_A_SECURE_RANDOM_SECRET"
